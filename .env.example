DATABASE_URL=postgresql://user:password@localhost:5432/safeguard
# Use a separate staging key from the HealthSherpa developer portal.
HEALTHSHERPA_API_BASE_URL=https://staging-api.one.healthsherpa.com
HEALTHSHERPA_API_KEY=
# Base44's HEALTHSHERPA_BASE_URL is accepted as a legacy server-only alias.
# Disabled until migration 003, isolated testing, and record reconciliation are complete.
HEALTHSHERPA_WORKFLOW_ENABLED=false
# Separately requires provider enrollment approval and linked Marketplace OAuth.
HEALTHSHERPA_ENROLLMENT_SESSIONS_ENABLED=false
# Exact Entra external ID of the agent linked to this deployment's HealthSherpa key.
HEALTHSHERPA_AGENT_EXTERNAL_ID=
DEMO_AUTH=true
